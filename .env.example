# ========================================================
# JIO GEMINI 18-MONTH HUNTER BOT - CONFIGURATION TEMPLATE
# ========================================================

# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Numeric Telegram Admin IDs (comma-separated, e.g. 123456789,987654321)
ADMIN_IDS=

# Access Control Policy: admin_only | allowlist | public
ACCESS_MODE=admin_only

# Grizzly SMS API Key (From https://grizzlysms.com/ profile/API settings)
GRIZZLY_API_KEY=your_grizzlysms_api_key_here

# Default service code on Grizzly SMS for MyJio 6-digit OTP delivery
# Options: jio (official MyJio, ~$0.10 USD), mjo (alternate route, ~$0.15 USD), mj
DEFAULT_SERVICE_CODE=jio

# Country ID for India on Grizzly SMS (22 = India)
DEFAULT_COUNTRY_ID=22

# Maximum price per number in USD (e.g. 0.40, 0.50)
DEFAULT_MAX_PRICE=0.45

# Optional proxy (HTTP or SOCKS5): e.g. socks5://user:pass@host:port or http://host:port
PROXY=

# Polling and Timeout Settings (in seconds)
OTP_TIMEOUT=90
POLL_INTERVAL=3
AUTO_SCAN_DELAY=2
